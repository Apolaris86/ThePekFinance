# Copy to apps/web/.env.local and fill in your own keys. Never commit real keys.

# Finnhub (live US prices + news) - https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Supabase (database + auth) - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI summaries) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend (alert emails) - https://resend.com
RESEND_API_KEY=
ALERT_EMAIL_TO=
